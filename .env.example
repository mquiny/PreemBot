# NCRBot Environment Variables Example
# Copy this file to `.env` and fill in your secrets and config values.
# DO NOT COMMIT THIS FILE WITH REAL SECRETS!
# Only use this as a template. Keep your real secrets out of version control.

# Discord Bot Token (required)
DISCORD_TOKEN=

# Discord Application Client ID (required for deploy-commands.js)
CLIENT_ID=

# Nexus Mods API Key (required)
NEXUS_API_KEY=

# Application Name and Version for Nexus Mods API (optional but recommended)
APP_NAME=NCRBot
APP_VERSION=1.0.0

# Channel IDs for log scanning and crash log uploads (required for log analysis)
CRASH_LOG_CHANNEL_ID=1287876503811653785
LOG_SCAN_CHANNEL_ID=1414027269680267274

# Audit logging channel (optional, can be set via /auditlog channel command)
# AUDIT_CHANNEL_ID=

# OpenAI API Key — removed, AI integration has been replaced by the local crash knowledge base
# OPENAI_API_KEY=

# Pterodactyl API Key (for GitHub Actions, set as GitHub secret, NOT here)
# PTERODACTYL_API_KEY=   # <-- Do NOT put in .env, use GitHub secrets only

# Any other custom config variables can go here...
# ...
# Enable auto-sync of slash commands on bot startup (optional, recommended for dev)
AUTO_SYNC_COMMANDS=false

# Optional: Guild IDs for command sync (preferred; comma-separated)
# Example: GUILD_IDS=1285796904160202752,222222222222222222
GUILD_IDS=

# Optional legacy single-guild key (used only when GUILD_IDS is unset)
# GUILD_ID=

# Per-guild channel mappings (required for true multi-guild behavior)
# Format: guildId:channelId,guildId2:channelId2
SHOWCASE_CHANNEL_IDS=
BOT_SPAM_CHANNEL_IDS=

# How many unique reactors (any emoji) a #showcase post needs before it's
# auto-featured on the site. Optional, defaults to 10.
# SHOWCASE_REACTION_THRESHOLD=10

# Emoji(s) that instant-feature a #showcase post when reacted by a staff
# member (see config/moderatorRoles.json for who counts as staff per
# guild) — no reaction-count threshold needed. Comma-separated, so
# multiple custom emojis can all count. For a custom emoji use its name
# without colons (e.g. PEsamurai, not :PEsamurai:). Optional, defaults to
# the unicode star.
# SHOWCASE_STAFF_EMOJIS=⭐,PEsamurai,PEskippywtf

# Per-guild category to create the live "Family Members" / "Boosters"
# stat voice channels under (see services/ServerStatsService.js). A guild
# with no entry here gets no stat channels at all.
# Format: guildId:categoryId,guildId2:categoryId2
STATS_CATEGORY_IDS=

# Per-guild collection slug to show "Mods" / "Revision" stat channels for,
# alongside the ones above. A guild with no entry here just gets the
# Family Members/Boosters channels, no mods/revision ones.
# Format: guildId:slug,guildId2:slug2
STATS_COLLECTION_SLUGS=

# MySQL Database for Street Creed system
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ncrbot

# Optional runtime diagnostics tuning (milliseconds unless noted)
HEALTH_LOG_INTERVAL_MS=30000
HEALTH_STALE_THRESHOLD_MS=600000
STARTUP_READY_TIMEOUT_MS=60000
HEAP_GROWTH_WARN_MB=25
EVENT_LOOP_LAG_WARN_MS=250
HANDLER_WARN_MS=1000
HANDLER_PENDING_WARN_MS=15000
PENDING_PROMISE_WARN_MS=60000
